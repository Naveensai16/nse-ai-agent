# ==============================================================================
# NSE Agentic AI Stock Analysis Application - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure as needed.
# NO OpenAI API key or external AI credentials are required.

# Application Configuration
APP_ENV=production
LOG_LEVEL=INFO

# Data & Storage
DATA_DIR=./data

# Ollama Private Server LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=18.0
OLLAMA_MAX_PROMPT_LENGTH=1500
OLLAMA_MAX_CONCURRENCY=4

# Docker Compose internal URL (uncomment when running with docker-compose):
# OLLAMA_BASE_URL=http://ollama:11434

# Market Data Settings
YAHOO_FINANCE_TIMEOUT_SECONDS=10
